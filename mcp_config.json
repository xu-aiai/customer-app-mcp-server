{
  "mcpEndpoint": "ws://your-xiaozhi-host/mcp_endpoint/mcp/?token=your-token",
  "mcpServers": {
    "customer-app-mcp-server": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server"]
    },
    "remote-sse-server": {
      "type": "sse",
      "url": "https://api.example.com/sse",
      "disabled": true
    },
    "remote-http-server": {
      "type": "http",
      "url": "https://api.example.com/mcp",
      "disabled": true
    }
  }
}
